# Application Environment Configuration
PROJECT_NAME="Information Integrity & AI Defense Workbench"
DEBUG=true
LOG_LEVEL=INFO

# Server & Database
DATABASE_URL=sqlite:///./provenance_defense.db

# Free / Public Data Sources Configuration
DATA_SOURCES_ENABLED=gdelt,rss

# GDELT Project (Primary Free/Public Source - No API Key Required)
GDELT_ENABLED=true
GDELT_POLL_INTERVAL=900
GDELT_MAX_RESULTS=25
GDELT_QUERY_KEYWORDS=disinformation OR "fake news" OR "generative AI" OR LLM OR deepfake OR propaganda OR "cyberattack" OR "influence operation"
GDELT_LANGUAGE=English
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc

# RSS Feeds (Optional Free/Public Source)
RSS_ENABLED=true
RSS_POLL_INTERVAL=1800
RSS_FEEDS=https://feeds.bbci.co.uk/news/technology/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml

# Bluesky Public Stream (Optional - Disabled by Default)
BLUESKY_ENABLED=false
BLUESKY_ENDPOINT=https://public.api.bsky.app

# CORS
CORS_ORIGINS=http://localhost:9207,http://127.0.0.1:9207,http://localhost:5173
